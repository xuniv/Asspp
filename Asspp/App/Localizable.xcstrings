    "Import an IPA from ipatool or another tool without adding an Apple account. Files are kept temporarily and removed after 24 hours or when Asspp restarts. Total storage is limited to 8 GiB." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import an IPA from ipatool or another tool without adding an Apple account. Files are kept temporarily and removed after 24 hours or when Asspp restarts. Total storage is limited to 8 GiB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需添加 Apple 账户即可导入 ipatool 等工具获取的 IPA。文件为临时保存，24 小时后或 Asspp 重启时删除，总存储上限为 8 GiB。"
          }
        }
      }
